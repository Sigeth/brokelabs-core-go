{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sigeth/opslab-core-go/main/schema/catalog-index.schema.json",
  "$ref": "#/$defs/CatalogIndex",
  "$defs": {
    "CatalogEntry": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the package."
        },
        "title": {
          "type": "string",
          "description": "Title of the challenge."
        },
        "summary": {
          "type": "string",
          "description": "Summary of the challenge.\n+optional"
        },
        "category": {
          "type": "string",
          "enum": [
            "linux-hardening",
            "containers",
            "kubernetes"
          ],
          "description": "Category of the challenge."
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard",
            "insane"
          ],
          "description": "Difficulty of the challenge."
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Tags of the challenge.\n+optional"
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/CatalogVersion"
          },
          "type": "array",
          "description": "Versions available, newest first.\n+kubebuilder:validation:MinItems=1"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "title",
        "category",
        "difficulty",
        "versions"
      ],
      "description": "CatalogEntry describes one package of a catalog."
    },
    "CatalogIndex": {
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "opslab.io/v1alpha1",
          "description": "APIVersion must be \"opslab.io/v1alpha1\"."
        },
        "kind": {
          "type": "string",
          "const": "CatalogIndex",
          "description": "Kind must be \"CatalogIndex\"."
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/CatalogEntry"
          },
          "type": "array",
          "description": "Packages published by the catalog."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "packages"
      ],
      "description": "CatalogIndex is the document a catalog publishes (as a signed OCI artifact) to list its packages."
    },
    "CatalogVersion": {
      "properties": {
        "version": {
          "type": "string",
          "description": "Version (semver)."
        },
        "ref": {
          "type": "string",
          "description": "Ref is the OCI reference of the package, pinned by digest\n(registry/repository@sha256:...)."
        },
        "permissions": {
          "$ref": "#/$defs/RequiredPermissions",
          "description": "Permissions the package needs, derived from it when the index was\nbuilt. The operator derives them again at install and refuses a package\nwhose permissions differ."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "ref",
        "permissions"
      ],
      "description": "CatalogVersion is one published version of a package."
    },
    "RequiredPermissions": {
      "properties": {
        "runtimes": {
          "items": {
            "type": "string",
            "enum": [
              "pod",
              "sysbox",
              "vcluster",
              "vm"
            ]
          },
          "type": "array",
          "description": "Runtimes used by the machines, sorted."
        },
        "cpu": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
            },
            {
              "type": "number"
            }
          ],
          "description": "CPU requested by the machines of one instance."
        },
        "memory": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
            },
            {
              "type": "number"
            }
          ],
          "description": "Memory requested by the machines of one instance."
        },
        "egress": {
          "type": "string",
          "enum": [
            "none",
            "internet",
            "allowlist"
          ],
          "description": "Egress is the outbound network access of an instance."
        },
        "egressAllowlist": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "EgressAllowlist lists the host names reachable when egress is \"allowlist\".\n+optional"
        },
        "extraManifestKinds": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "ExtraManifestKinds are the kinds created in the instance namespace by\nextraManifests, as \"Kind\" (core group) or \"Kind.group\", sorted.\n+optional"
        },
        "checkerImage": {
          "type": "string",
          "description": "CheckerImage is the custom checker, which runs with access to the\nmachines of the instance.\n+optional"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "runtimes",
        "cpu",
        "memory",
        "egress"
      ],
      "description": "RequiredPermissions are what a package needs from the cluster."
    }
  }
}
